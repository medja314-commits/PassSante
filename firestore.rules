rules_version = '2';

// Règles versionnées ici pour relecture. Elles doivent être copiées dans la console Firebase
// (Firestore > Règles) : le dépôt ne les déploie pas seul.
// Le rôle et le patientId sont lus dans le JWT (custom claims), posés par le serveur : aucune lecture de document « rôle ».
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil : lisible par son propriétaire uniquement. Aucune écriture côté client.
    match /users/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Rendez-vous, selon la matrice « rdv » de lib/rbac.ts.
    // Lecture : personnel ayant accès aux rendez-vous, ou patient sur ses propres rendez-vous.
    // Création : médecin et secrétaire. Modification et suppression : aucune (à ouvrir plus tard, sous contrôle).
    match /appointments/{id} {
      allow read: if request.auth != null && (
        request.auth.token.role in ['medecin', 'infirmier', 'secretaire'] ||
        (request.auth.token.role == 'patient' && resource.data.patientId == request.auth.token.patientId)
      );
      allow create: if request.auth != null && request.auth.token.role in ['medecin', 'secretaire'];
      allow update, delete: if false;
    }

    // Index matricule → compte : réservé au serveur (Firebase Admin ignore ces règles).
    match /matricules/{matricule} {
      allow read, write: if false;
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

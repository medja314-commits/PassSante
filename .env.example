# Copier ce fichier en .env.local et remplir les valeurs. .env.local n'est jamais committé.

# --- Firebase, configuration client (publique par nature, console Firebase > Paramètres du projet > Vos applications) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin, SERVEUR UNIQUEMENT (console Firebase > Paramètres du projet > Comptes de service > Générer une clé privée) ---
# Ne jamais préfixer par NEXT_PUBLIC_. Ne jamais committer ni afficher ces valeurs.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Mode démonstration (secours) : désactivé par défaut. À mettre à true uniquement pour la démo. ---
DEMO_MODE=false
